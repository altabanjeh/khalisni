# Python
.venv/
__pycache__/
backend/**/__pycache__/
backend/db.sqlite3
*.sqlite3
*.sqlite3.*
*.bak

# Django build artifacts — generated at runtime, never commit
backend/media/
backend/staticfiles/

# Frontend build artifacts — generated by `npm run build`, never commit
frontend/node_modules/
frontend/dist/
frontend/dist-acceptance/
frontend/.npm-cache/
frontend/.ruff_cache/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/e2e-results/artifacts/
frontend/e2e-results/*.json
frontend/e2e-results/e2e_db.sqlite3

# Secrets — never commit real credentials
.env
backend/.env
*.local.env
mobile/.env
mobile/.env.*

# Mobile / Expo local state
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/

# Logs and local tooling
logs/
*.log
.vscode/
.DS_Store
Thumbs.db
/WhatsApp Image *.jpeg
**/.vscode/

# Root-level business documents and local design assets
/*.pdf
/*.docx
/*.xlsx
/*.jpeg
/imges/
/khalasni_design_system.html
/docs/system_review.zip
