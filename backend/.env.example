# DJANGO_SECRET_KEY is now ALWAYS required: DJANGO_DEBUG defaults to False
# (defect D3), and a missing secret key raises ImproperlyConfigured.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Set to True for local development only. Leave unset / False everywhere else.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# JWT lifetimes (defect D4). Short access token; refresh rotates + blacklists.
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
DJANGO_TIME_ZONE=Asia/Amman
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=khalasni
POSTGRES_USER=khalasni
POSTGRES_PASSWORD=khalasni
POSTGRES_HOST=db
POSTGRES_PORT=5432
FILE_UPLOAD_MAX_SIZE=5242880
